# ==============================================================================
# Modèle des variables d'environnement - Portail Citoyen Dunières & Haut Pays du Velay
# ==============================================================================
# Renommez ce fichier en '.env' pour les tests en local.
# En production sur GitHub, ces valeurs sont configurées dans GitHub Secrets.

# ------------------------------------------------------------------------------
# 1. INTELLIGENCE ARTIFICIELLE (Filtrage, catégorisation & extraction dates)
# ------------------------------------------------------------------------------
# Clé API Google Gemini (utilisée pour analyser les annonces, filtrer le contenu
# d'intérêt public local et formater les dates/titres de manière normalisée)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# 2. NOTIFICATIONS WHATSAPP (CallMeBot) - Optionnel
# ------------------------------------------------------------------------------
# Pour recevoir chaque matin un compte-rendu d'exécution et les alertes majeures
# Obtenez votre clé gratuite sur https://www.callmebot.com/ (via message WhatsApp)
CALLMEBOT_PHONE=+33600000000
CALLMEBOT_API_KEY=1234567

# ------------------------------------------------------------------------------
# 3. VEILLE EMAIL / BULLETINS MUNICIPAUX (IMAP) - Optionnel
# ------------------------------------------------------------------------------
# Si une boîte mail municipale/communautaire dédiée est interrogée
IMAP_SERVER=imap.example.com
IMAP_PORT=993
IMAP_USER=votre-adresse@domaine.fr
IMAP_PASSWORD=votre-mot-de-passe-d-application

# ------------------------------------------------------------------------------
# 4. CONFIGURATION GÉNÉRALE
# ------------------------------------------------------------------------------
TIMEZONE=Europe/Paris
COMMUNE_NOM=Dunières
COMMUNE_INSEE=43087
COMMUNAUTE_COMMUNES="Haut Pays du Velay Communauté"
SLIDING_WINDOW_PAST_DAYS=15
SLIDING_WINDOW_FUTURE_DAYS=15
DEBUG_MODE=false
